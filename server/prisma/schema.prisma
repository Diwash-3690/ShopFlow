
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  VENDOR_REGISTER
  CUSTOMER_REGISTER
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PHONE_CHANGE
  MOBILE_VERIFICATION
}

enum OrderType {
  ONLINE
  WALK_IN
}

enum OrderStatus {
  AWAITING_PICKUP
  COMPLETED
}

enum PaymentMethod {
  UPI
  CASH
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

enum NotificationType {
  NEW_ORDER
  OUT_OF_STOCK
}

model Vendor {
  id              String   @id @default(cuid())
  ownerName       String
  mobile          String   @unique
  passwordHash    String
  mobileVerified  Boolean  @default(false)
  isActive        Boolean  @default(true)
  email           String?  @unique
  emailVerified   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop            Shop?
  reports         Report[]
}

model Shop {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  shopId          String   @unique
  shopName        String
  shopNumber      String?  @unique
  address         String
  contactNumber   String
  latitude        Float?
  longitude       Float?
  upiId           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  categories      Category[]
  products        Product[]
  orders          Order[]
  notifications   Notification[]
  reports         Report[]
}

model Customer {
  id              String   @id @default(cuid())
  mobile          String   @unique
  passwordHash    String
  mobileVerified  Boolean  @default(false)
  isActive        Boolean  @default(true)
  email           String?  @unique
  emailVerified   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
  reports         Report[]
}

model Category {
  id              String   @id @default(cuid())
  shopId          String
  name            String
  createdAt       DateTime @default(now())

  shop            Shop      @relation(fields: [shopId], references: [id])
  products        Product[]

  @@unique([shopId, name])
}

model Product {
  id              String   @id @default(cuid())
  shopId          String
  categoryId      String?
  name            String
  description     String?
  imageUrl        String?
  costPrice       Decimal  @db.Decimal(12, 2)
  sellingPrice    Decimal  @db.Decimal(12, 2)
  stockQuantity   Int      @default(0)
  unit            String   @default("piece")
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop            Shop          @relation(fields: [shopId], references: [id])
  category        Category?     @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  notifications   Notification[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  pickupId        String?     @unique
  shopId          String
  customerId      String?
  orderType       OrderType
  status          OrderStatus @default(AWAITING_PICKUP)
  subtotal        Decimal     @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  completedAt     DateTime?

  shop            Shop          @relation(fields: [shopId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  payment         Payment?
  bill            Bill?
  notifications   Notification[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  productName     String
  quantity        Int
  unit            String
  unitPrice       Decimal  @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)

  order           Order    @relation(fields: [orderId], references: [id])
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  method                PaymentMethod
  status                PaymentStatus @default(PENDING)
  vendorUpiId           String?
  providerTransactionId String?       @unique
  paidAt                DateTime?
  createdAt             DateTime      @default(now())

  order                 Order         @relation(fields: [orderId], references: [id])
}

model Bill {
  id              String   @id @default(cuid())
  orderId         String   @unique
  billNumber      String   @unique
  subtotal        Decimal  @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)
  issuedAt        DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id])
}

model Notification {
  id              String           @id @default(cuid())
  shopId          String
  productId       String?
  orderId         String?
  type            NotificationType
  title           String
  message         String
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  shop            Shop       @relation(fields: [shopId], references: [id])
  product         Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  order           Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model OtpVerification {
  id              String     @id @default(cuid())
  mobile          String
  email           String?
  purpose         OtpPurpose
  codeHash        String
  expiresAt       DateTime
  verifiedAt      DateTime?
  createdAt       DateTime   @default(now())

  @@index([mobile, purpose])
  @@index([email, purpose])
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String   @default("Platform Admin")
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ReportCategory {
  MISBEHAVIOUR
  PAYMENT_DISPUTE
  FRAUD_SUSPICION
  ORDER_ISSUE
  INCORRECT_INVENTORY
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id           String         @id @default(cuid())
  reportNumber String         @unique
  reporterType String         // "CUSTOMER" | "VENDOR"
  customerId   String?
  vendorId     String?
  shopId       String?
  orderNumber  String?
  category     ReportCategory @default(OTHER)
  subject      String
  description  String
  status       ReportStatus   @default(PENDING)
  adminNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor       Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  shop         Shop?          @relation(fields: [shopId], references: [id], onDelete: SetNull)
}
